# Export these variables in the backend shell to enable real Jev decisions.

# Leaving TYPESAFE_API_KEY empty selects the visibly labeled local policy.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
AI_TIMEOUT=8
AI_TEMPERATURE=0.25
# true: Jev is not asked about fixtures (inspecting, waiting, the WC, leaving) nobody has a reason to weigh.
AI_LEAN=true
# true: a guest who chooses to talk also chooses what for (news, a game, an ale, a rematch); the line writer reads it.
AI_AIMS=true
# true: a thirsty guest with no seat may choose the whole of settling in (ale, chair, drink) at once.
AI_PROJECTS=true
# true: an invited guest decides for themselves whether to accept, decline or offer something else. Off by default:
# in live evenings it cut accepted invitations from 3.6 to 1.0 an evening and dice games to a quarter (see C7).
AI_ANSWERS=false

# Claude Haiku 5.5 compiles player-written character cards; empty runs the labeled offline mode.
ANTHROPIC_API_KEY=

# LangSmith API key
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tavern
LANGSMITH_ENDPOINT=https://api.smith.langchain.com