# Export these variables in the backend shell to enable real Jev decisions.

# Leaving TYPESAFE_API_KEY empty selects the visibly labeled local policy.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
AI_TIMEOUT=8
AI_TEMPERATURE=0.25
# true: Jev is not asked about fixtures (inspecting, waiting, the WC, leaving) nobody has a reason to weigh.
AI_LEAN=true

# Claude Haiku 5.5 compiles player-written character cards; empty runs the labeled offline mode.
ANTHROPIC_API_KEY=

# LangSmith API key
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tavern
LANGSMITH_ENDPOINT=https://api.smith.langchain.com